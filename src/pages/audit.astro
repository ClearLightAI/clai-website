---
/**
 * /audit — dedicated AI Readiness Audit page.
 *
 * Replaces the ElevenLabs hosted talk-to page (which ignores widget avatar
 * styling and renders their default green orb on white). The embedded widget
 * DOES honor the published widget config (purple orb #745aa5/#7789d9, dark bg,
 * gold button), so we host it ourselves: the widget centered in a
 * full-screen-ish glass tile, with page padding so the starfield shows
 * through around the frame.
 *
 * audit.clearlightai.com should 301 here (Cloudflare rule) instead of
 * elevenlabs.io/app/talk-to.
 */
import Layout from "../layouts/Layout.astro";
import Starfield from "../components/Starfield.astro";
import Nav from "../components/Nav.astro";

const AGENT_ID = "agent_3601kktqh8pfej0ayy03jfaj7z1b";
// Pinned to Main. The v2 branch runtime has a stuck ~4-10s per-turn latency
// regardless of its LLM/turn/TTS config (measured 2026-08-13, raw WS API);
// Main with identical settings answers in ~1.6s. v2's leaner prompt +
// first_message were copied onto Main, and Main's LLM/TTS/turn were tuned
// (gemini-2.5-flash, eleven_turbo_v2, no backup-override cascade).
const BRANCH_ID = "agtbrch_2601kktqh9ffe0m83yzzamy9m6kt";
---

<Layout
  title="Free AI Readiness Audit | ClearLight AI"
  description="Begin your free 10-15 minute AI Readiness Audit with ClearLight AI. Talk to the Audit Wizard and get a phased AI implementation roadmap for your business."
>
  <Starfield />
  <Nav />

  <main class="aw-page">
    <header class="aw-head">
      <p class="aw-eyebrow">Free AI Readiness Audit</p>
      <h1 class="aw-title">
        Talk to the
        <span style="background: linear-gradient(90deg, #745aa5, #7789d9); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;">Audit Wizard.</span>
      </h1>
      <p class="aw-sub">
        A 10&ndash;15 minute conversation about your business. You leave with a
        phased AI roadmap. Start when you're ready.
      </p>
    </header>

    <section class="aw-tile">
      <span class="aw-strip" aria-hidden="true"></span>
      <div class="aw-widget-wrap">
        <elevenlabs-convai agent-id={AGENT_ID} branch-id={BRANCH_ID} variant="expanded" always-expanded="true" use-rtc="true"></elevenlabs-convai>
      </div>
    </section>
    <p class="aw-mode-note" id="aw-voice-back" hidden>
      Chat mode &mdash; replies appear as text.
      <a href="#" id="aw-voice-back-link">Prefer voice? Switch back to the call.</a>
    </p>
  </main>

  <script src="https://unpkg.com/@elevenlabs/convai-widget-embed" async type="text/javascript" is:inline></script>
  <script is:inline>
    // The widget's expanded "sheet" is absolutely positioned bottom-right and
    // capped at 400x550 inside its (open) shadow root. Inject a style to make
    // it fill our glass tile instead.
    (function () {
      var css =
        'div[class*="overlay"] > div[class*="sheet"]{position:absolute !important;inset:0 !important;' +
        'width:100% !important;height:100% !important;max-width:none !important;' +
        'max-height:none !important;border-radius:16px !important;}' +
        /* Input bar: white field, purple text, clearly visible on the navy sheet */
        /* Agent messages render as bare text (no bubble component) — wrap them
           in a bubble to mirror the user side */
        'div[class="pr-8"]{background:#2f3175 !important;color:#f0eff5 !important;' +
        'padding:10px 14px !important;border-radius:14px 14px 14px 4px !important;' +
        'width:fit-content;max-width:85%;}' +
        /* Chat input: match the feedback box — navy field, gold border, white text */
        'div[class*="sticky"] div:has(> textarea){background:transparent !important;border:1px solid #e5b673 !important;}' +
        'div[class*="sticky"] textarea{background:transparent !important;color:#f0eff5 !important;caret-color:#e5b673 !important;}' +
        'div[class*="sticky"] textarea::placeholder{color:rgba(240,239,245,0.55) !important;opacity:1 !important;}' +
        /* Mode toggle: icon-only button -> labeled gold CTA (label from aria-label) */
        'button[aria-label="Switch to Chat Mode"],button[aria-label="Switch to Voice Mode"]{' +
        'width:auto !important;background:#e5b673 !important;color:#13123b !important;' +
        'border-radius:9999px !important;padding:0 14px !important;gap:8px !important;}' +
        'button[aria-label="Switch to Chat Mode"]:hover,button[aria-label="Switch to Voice Mode"]:hover{background:#efc98c !important;}' +
        'button[aria-label="Switch to Chat Mode"]::after,button[aria-label="Switch to Voice Mode"]::after{' +
        'content:attr(aria-label);font-size:0.85rem;font-weight:600;white-space:nowrap;}' +
        /* Fake typing indicator (page-side; the widget has none for standard agents) */
        '.aw-typing{display:flex;gap:5px;align-items:center;height:14px;}' +
        '.aw-typing span{width:7px;height:7px;border-radius:50%;background:rgba(240,239,245,0.75);' +
        'animation:aw-bounce 1.2s infinite ease-in-out;}' +
        '.aw-typing span:nth-child(2){animation-delay:0.15s;}' +
        '.aw-typing span:nth-child(3){animation-delay:0.3s;}' +
        '@keyframes aw-bounce{0%,60%,100%{transform:translateY(0);opacity:0.55;}30%{transform:translateY(-4px);opacity:1;}}' +
        '@media (prefers-reduced-motion: reduce){.aw-typing span{animation:none;}}';
      var tries = 0;
      var timer = setInterval(function () {
        tries++;
        var el = document.querySelector("elevenlabs-convai");
        if (el && el.shadowRoot && el.shadowRoot.querySelector('div[class*="sheet"]')) {
          var style = document.createElement("style");
          style.textContent = css;
          el.shadowRoot.appendChild(style);
          setupTyping(el.shadowRoot);
          clearInterval(timer);
        } else if (tries > 100) {
          clearInterval(timer);
        }
      }, 100);

      // Fake typing indicator: show a dots bubble after the user sends a chat
      // message, remove it as soon as the agent's reply node appears.
      function setupTyping(sr) {
        var indicator = null;
        var failsafe = null;
        var waiting = false;

        function removeIndicator() {
          waiting = false;
          if (indicator) { indicator.remove(); indicator = null; }
          if (failsafe) { clearTimeout(failsafe); failsafe = null; }
        }

        function appendIndicator() {
          var sheet = sr.querySelector('div[class*="overlay"] > div[class*="sheet"]');
          var list = sheet && sheet.querySelector('div[class*="overflow-y-auto"] div[class*="flex-col"]');
          if (!list) return;
          if (!indicator) {
            indicator = document.createElement("div");
            indicator.className = "pr-8";
            indicator.setAttribute("data-aw-typing", "1");
            indicator.innerHTML = '<div class="aw-typing"><span></span><span></span><span></span></div>';
          }
          list.appendChild(indicator);
          indicator.scrollIntoView({ block: "end" });
        }

        function showIndicator() {
          removeIndicator();
          waiting = true;
          appendIndicator();
          failsafe = setTimeout(removeIndicator, 60000);
        }

        function isAgentReply(node) {
          if (node.nodeType !== 1 || node.hasAttribute("data-aw-typing")) return false;
          if (node.getAttribute("class") === "pr-8") return true;
          var inner = node.querySelector && node.querySelector('div[class="pr-8"]:not([data-aw-typing])');
          return !!inner;
        }

        new MutationObserver(function (muts) {
          if (!waiting) return;
          for (var i = 0; i < muts.length; i++) {
            var added = muts[i].addedNodes;
            for (var j = 0; j < added.length; j++) {
              if (isAgentReply(added[j])) { removeIndicator(); return; }
            }
          }
          // The widget's own re-renders drop foreign nodes or render entries
          // after ours (initial send) — keep the indicator attached and last
          if (indicator && (!indicator.isConnected ||
              (indicator.parentElement && indicator.parentElement.lastElementChild !== indicator))) {
            appendIndicator();
          }
        }).observe(sr, { childList: true, subtree: true });

        // Mode handling: mixed voice+chat sessions are broken at the platform
        // level (typed messages interrupt the voice pipeline; replies are
        // TTS-paced or invisible). So the mode is fixed per conversation:
        // typing before a call starts flips the widget to a text-only session
        // (instant replies); the call button keeps the voice/orb experience.
        var host = sr.host;
        var convoStarted = false;
        var note = document.getElementById("aw-voice-back");
        function enterChatMode() {
          if (convoStarted || host.getAttribute("override-text-only") === "true") return;
          host.setAttribute("override-text-only", "true");
          if (note) note.hidden = false;
        }
        var backLink = document.getElementById("aw-voice-back-link");
        if (backLink) backLink.addEventListener("click", function (e) {
          e.preventDefault();
          if (convoStarted) return;
          host.removeAttribute("override-text-only");
          if (note) note.hidden = true;
        });

        // Capture phase: the widget stops propagation of these events once a
        // conversation is live, so bubble-phase listeners never fire.
        sr.addEventListener("click", function (e) {
          var t = e.target;
          if (!t || !t.closest) return;
          if (t.closest('button[aria-label="Send"]')) {
            convoStarted = true;
            setTimeout(showIndicator, 150);
          } else if (t.closest("button") && /Start/.test(t.closest("button").textContent)) {
            convoStarted = true; // voice call locks the mode
          }
        }, true);
        sr.addEventListener("keydown", function (e) {
          var t = e.target;
          if (!t || t.tagName !== "TEXTAREA") return;
          if (e.key === "Enter" && !e.shiftKey) {
            if (t.value.trim()) { convoStarted = true; setTimeout(showIndicator, 150); }
          } else if (e.key.length === 1) {
            enterChatMode();
          }
        }, true);
      }
    })();
  </script>
</Layout>

<style>
  .aw-page {
    position: relative;
    z-index: 2;
    max-width: 1080px;
    margin: 0 auto;
    padding: 120px 24px 56px;
    display: flex;
    flex-direction: column;
    gap: 26px;
    min-height: 100vh;
    box-sizing: border-box;
  }

  .aw-head { text-align: center; }
  .aw-eyebrow {
    font-family: var(--font-display, "Garet", sans-serif);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #e5b673;
    margin-bottom: 14px;
  }
  .aw-title {
    font-family: var(--font-display, "Garet", sans-serif);
    font-weight: 300;
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 16px;
  }
  .aw-sub {
    font-size: clamp(1rem, 0.92rem + 0.28vw, 1.125rem);
    line-height: 1.6;
    color: rgba(240, 239, 245, 0.78);
    max-width: 56ch;
    margin: 0 auto;
  }

  /* Glass frame — thin, so the starfield reads around it */
  .aw-tile {
    position: relative;
    flex: 1;
    display: flex;
    background: rgba(20, 21, 56, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 26px;
    overflow: hidden;
    backdrop-filter: blur(3px);
    padding: 12px;
    min-height: 660px;
  }
  .aw-strip {
    position: absolute;
    left: 0; top: 0; right: 0;
    height: 5px;
    background: linear-gradient(90deg, #e5b673 0%, #725ba7 50%, #7789d9 100%);
  }

  .aw-widget-wrap {
    flex: 1;
    display: flex;
    align-items: stretch;
    justify-content: center;
    border-radius: 16px;
    overflow: hidden;
  }
  /* The widget positions itself fixed bottom-right by default; force it to
     behave as an in-flow, full-size panel inside the tile. Its shadow DOM
     inherits the --el-* theme vars, so we re-skin it to the brand here.
     Geometry (the 400x550 max sheet) is overridden by an injected shadow
     style in the script below. */
  .aw-widget-wrap elevenlabs-convai {
    position: static !important;
    width: 100%;
    height: 100%;
    display: block;
    --el-base: #141538;
    --el-base-hover: #1c1d4a;
    --el-base-active: #2f3175; /* also agent chat-bubble bg — must read against the navy sheet */
    --el-base-border: rgba(255, 255, 255, 0.12);
    --el-base-subtle: rgba(240, 239, 245, 0.62);
    --el-base-primary: #f0eff5;
    --el-accent: #e5b673;
    --el-accent-hover: #efc98c;
    --el-accent-active: #d9a75f;
    --el-accent-border: rgba(229, 182, 115, 0.4);
    --el-accent-subtle: rgba(229, 182, 115, 0.16);
    --el-accent-primary: #13123b;
  }

  .aw-mode-note {
    text-align: center;
    font-size: 0.85rem;
    color: rgba(240, 239, 245, 0.55);
    margin-top: -8px;
  }
  .aw-mode-note a {
    color: #e5b673;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .aw-mode-note a:hover { color: #efc98c; }

  @media (max-width: 640px) {
    .aw-page { padding: 100px 12px 24px; gap: 18px; }
    .aw-tile { padding: 8px; min-height: 600px; }
  }
</style>
